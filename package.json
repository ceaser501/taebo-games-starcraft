{
  "name": "taebo-games-starcraft",
  "version": "0.0.1",
  "description": "StarCraft: Brood War 스타일 실시간 전략 게임 (브라우저)",
  "private": true,
  "keywords": [
    ""
  ],
  "license": "",
  "author": "",
  "scripts": {
    "start": "webpack serve --open --config webpack.config.dev.js",
